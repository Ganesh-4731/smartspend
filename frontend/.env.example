# Base URL of the backend API.
# Leave as /api in development (Vite proxies /api to http://localhost:5000, so cookies are same-origin).
# In production set the full URL, e.g. https://api.example.com/api
VITE_API_URL=/api
# Dev-only: where the Vite dev server proxies /api requests
VITE_DEV_PROXY_TARGET=http://localhost:5000
