# Server
PORT=5000
NODE_ENV=development

# MongoDB (local) - or paste your Atlas connection string (mongodb+srv://...)
MONGODB_URI=mongodb://127.0.0.1:27017/smartspend

# Auth: generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=7d

# Frontend origin allowed by CORS (must match exactly, no trailing slash)
FRONTEND_URL=http://localhost:5173

# Cookie settings. In production over HTTPS set COOKIE_SECURE=true.
# If frontend and API are on different sites use COOKIE_SAMESITE=none (requires COOKIE_SECURE=true).
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Set to 1 when running behind a reverse proxy (Render, Heroku, Nginx...)
TRUST_PROXY=0
